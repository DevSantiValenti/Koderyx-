---
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import { site, whatsappUrl } from '../config/site';
interface Props { standalone?: boolean; }
const { standalone = false } = Astro.props;
const Heading = standalone ? 'h1' : 'h2';
---
<section id="contacto" class:list={['section', 'contact-section', { 'contact-standalone': standalone }]} aria-labelledby="contact-title"><div class="container contact-layout"><div class="contact-copy"><div class="eyebrow"><span class="status-dot"></span> EL PRÓXIMO PASO EMPIEZA ACÁ</div><Heading id="contact-title">Contanos<br />qué <span class="lime">necesitás.</span></Heading><p>Comentanos tu idea, problema o proyecto y evaluamos juntos la mejor solución.</p><div class="contact-divider"></div><span class="contact-direct-label">¿PREFERÍS UNA CONVERSACIÓN DIRECTA?</span>{whatsappUrl && <a class="contact-direct" href={whatsappUrl} target="_blank" rel="noopener noreferrer" data-event="click_whatsapp"><Icon name="whatsapp" size={23} />Hablar por WhatsApp <Icon name="diagonal" size={18} /></a>}{site.email && <a class="button button-outline contact-email" href={`mailto:${site.email}`} aria-label={`Enviar email a ${site.email}`}><Icon name="mail" size={19} />{site.email}<Icon name="diagonal" size={16} /></a>}<p class="contact-note">No hace falta tener todo definido.<br />Podemos empezar por una buena conversación.</p></div><ContactForm /></div></section>
