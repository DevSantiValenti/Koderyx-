---
import { projects } from '../data/projects';
import ProjectImage from '../components/ProjectImage.astro';
import Icon from '../components/Icon.astro';
---
<section id="proyectos" class="section projects-section" aria-labelledby="projects-title">
  <div class="container">
    <div class="section-heading"><div><div class="eyebrow"><span class="section-index">02 /</span> DEL CÓDIGO A LA REALIDAD</div><h2 id="projects-title">Ideas que ya son<br />soluciones<span class="lime">.</span></h2></div><div class="heading-aside"><p>Proyectos reales. Necesidades diferentes.<br />La misma atención a cada detalle.</p><a class="text-link" href="/proyectos">Explorar proyectos <Icon name="arrow" size={18} /></a></div></div>
    <div class="projects-grid">{projects.map(project => <article class="project-card">
      <a href={`/proyectos/${project.slug}`} aria-label={`Ver proyecto ${project.name}, ${project.category}`} class="project-image-link"><ProjectImage project={project} /></a>
      <div class="project-info"><span class="project-sector">{project.sector}</span><h3><a href={`/proyectos/${project.slug}`}>{project.name}</a></h3><p>{project.description}</p><a class="text-link" href={`/proyectos/${project.slug}`} aria-label={`Ver proyecto ${project.name}`}>Ver proyecto <Icon name="diagonal" size={17} /></a></div>
    </article>)}</div>
  </div>
</section>
