---
import { faqs } from '../data/content';
import Icon from '../components/Icon.astro';
---
<section id="preguntas" class="section faq-section" aria-labelledby="faq-title">
  <div class="container faq-layout"><div><div class="eyebrow"><span class="section-index">06 /</span> ANTES DE EMPEZAR</div><h2 id="faq-title">Preguntas<br />frecuentes<span class="lime">.</span></h2><p class="section-intro">Cada proyecto es distinto.<br />Estas respuestas son un buen comienzo.</p><a class="text-link" href="/contacto">Hablemos de tu caso <Icon name="diagonal" size={17} /></a></div><div class="faq-list">{faqs.map(item => <details name="faq"><summary>{item.question}<Icon name="plus" size={19} /></summary><p>{item.answer}</p></details>)}</div></div>
</section>
