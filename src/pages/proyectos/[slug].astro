---
import Layout from '../../layouts/Layout.astro';
import ProjectImage from '../../components/ProjectImage.astro';
import CallToAction from '../../components/CallToAction.astro';
import Icon from '../../components/Icon.astro';
import { projects, type Project } from '../../data/projects';
import { site } from '../../config/site';
export function getStaticPaths() { return projects.map(project => ({ params: { slug: project.slug }, props: { project } })); }
interface Props { project: Project; }
const { project } = Astro.props;
const others = projects.filter(item => item.slug !== project.slug);
const schema = { '@type': 'CreativeWork', name: project.name, description: project.description, url: `${site.domain}/proyectos/${project.slug}`, creator: { '@id': `${site.domain}/#organization` } };
---
<Layout title={`${project.name} · ${project.category} | KODERYX`} description={project.description} schema={schema}>
  <article data-project={project.slug}>
    <header class="page-intro container project-intro"><a class="breadcrumb" href="/proyectos">Proyectos <span>/ {project.name}</span></a><div class="eyebrow">{project.sector}</div><h1>{project.name}<span class="lime">.</span></h1><p>{project.description}</p><div class="project-tags"><span>{project.category}</span>{project.technologies.map(technology => <span>{technology}</span>)}</div>{project.url && <a class="text-link" href={project.url} target="_blank" rel="noopener noreferrer">Visitar sitio <Icon name="diagonal" size={18} /></a>}</header>
    <div class="container"><ProjectImage project={project} large /></div>
    <div class="container case-grid section"><aside><div class="eyebrow">EL PROYECTO</div><nav aria-label="Contenido del proyecto"><a href="#problema">01 · El desafío</a><a href="#solucion">02 · La solución</a><a href="#funcionalidades">03 · Funcionalidades</a><a href="#capturas">04 · Capturas</a><a href="#tecnologias">05 · Tecnologías</a><a href="#resultado">06 · Resultado</a></nav></aside><div class="case-content">
      <section id="problema"><span class="eyebrow">01 / EL DESAFÍO</span><h2>El problema a resolver</h2><p>{project.problem}</p></section>
      <section id="solucion"><span class="eyebrow">02 / LA SOLUCIÓN</span><h2>Una herramienta con foco</h2><p>{project.solution}</p></section>
      <section id="funcionalidades"><span class="eyebrow">03 / FUNCIONALIDADES</span><h2>Qué permite hacer</h2><ul class="feature-list">{project.features.map(feature => <li><Icon name="check" size={18} />{feature}</li>)}</ul></section>
      <section id="capturas"><span class="eyebrow">04 / UNA MIRADA AL PRODUCTO</span><h2>Capturas del proyecto</h2>{project.screenshots.length ? <div class="screenshot-gallery">{project.screenshots.map(image => <figure><img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" /><figcaption>{image.alt}</figcaption></figure>)}</div> : <div class="gallery-pending"><Icon name="image" size={32} /><p>Próximamente, capturas de la interfaz real de {project.name}.</p><span>Las imágenes de esta ficha no representan pantallas del producto.</span></div>}</section>
      <section id="tecnologias"><span class="eyebrow">05 / TECNOLOGÍAS</span><h2>La base técnica</h2>{project.technologies.length ? <ul class="technology-list">{project.technologies.map(technology => <li>{technology}</li>)}</ul> : <p>La ficha técnica de este proyecto está pendiente de publicación. Podemos conversar sobre los requisitos de una solución similar.</p>}</section>
      <section id="resultado"><span class="eyebrow">06 / RESULTADO</span><h2>Lo que se construyó</h2><p>{project.result}</p></section>
    </div></div>
  </article>
  <div class="container related-projects"><h2>Más proyectos</h2><div>{others.map(other => <a href={`/proyectos/${other.slug}`}><span>{other.category}<strong>{other.name}</strong></span><Icon name="diagonal" size={24} /></a>)}</div></div>
  <CallToAction />
</Layout>
